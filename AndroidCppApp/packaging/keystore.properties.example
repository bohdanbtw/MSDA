# Copy this file to keystore.properties and fill in your values.
# Run AndroidCppApp/tools/setup-release-signing.ps1 to generate a new keystore automatically.
#
# NEVER commit keystore.properties or release.jks to git.

storeFile=release.jks
storePassword=CHANGE_ME_store_password
keyAlias=upload
keyPassword=CHANGE_ME_key_password
